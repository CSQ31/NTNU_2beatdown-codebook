# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Explicitly enforce LF for key file types
*.h      text eol=lf
*.hpp    text eol=lf
*.c      text eol=lf
*.cc     text eol=lf
*.cpp    text eol=lf
*.tex    text eol=lf
*.sty    text eol=lf
*.cls    text eol=lf
*.bib    text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
Makefile text eol=lf
